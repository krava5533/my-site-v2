# ============================================================
# LUXESTONE INTERIORS LTD. — ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in real values.
# The site runs fully in MOCK_MODE without any of the below.
# ============================================================

# --- MODE -----------------------------------------------------
# true = use in-memory/JSON mock data, simulated email/Telegram/storage
# false = use real Postgres, real email, real Telegram, real file storage
MOCK_MODE=true

# --- APP --------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="LuxeStone Interiors Ltd."

# --- COMPANY / CONTACT (DO NOT invent real values — leave blank until provided) ---
COMPANY_LEGAL_NAME="LuxeStone Interiors Ltd."
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
SHOWROOM_ADDRESS=
SHOWROOM_PHONE=
SHOWROOM_EMAIL=
SHOWROOM_HOURS=
GOOGLE_MAPS_EMBED_URL=

# --- DATABASE (Postgres, only needed when MOCK_MODE=false) -----
DATABASE_URL="postgresql://user:password@localhost:5432/luxestone?schema=public"

# --- AUTH (NextAuth / Auth.js) ----------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
ADMIN_SEED_EMAIL=admin@luxestone.example
ADMIN_SEED_PASSWORD=change-me-immediately

# --- EMAIL (choose one provider; abstraction picks automatically) ---
EMAIL_PROVIDER=resend # resend | smtp
RESEND_API_KEY=
EMAIL_FROM="LuxeStone Interiors <no-reply@luxestone.example>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- TELEGRAM (optional) ----------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- AI AGENT (Telegram bot replies / SMS / email auto-reply) ---
# Powers automatic customer replies across Telegram, SMS, and email.
# Without this key, the agent webhooks still log incoming messages
# but reply with a generic fallback instead of a real AI draft.
ANTHROPIC_API_KEY=

# --- SMS (Twilio, for the AI agent's SMS auto-reply) -------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- FILE STORAGE (only needed when MOCK_MODE=false) ------------
STORAGE_PROVIDER=local # local | s3 | cloudinary | vercel-blob
MAX_UPLOAD_SIZE_MB=25
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BLOB_READ_WRITE_TOKEN=

# --- ANALYTICS (optional) ---------------------------------------
NEXT_PUBLIC_ANALYTICS_ID=
